{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.6.84",
  "version_name": "2.6 Build 84 · Canonical Integrations Center",
  "description": "Canonical integrations center for GitHub App, Supabase OAuth, Lovable project mappings and Gemini readiness. No legacy UI restoration or integration polling.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "unlimitedStorage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "launcher/launcher-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "content/content.js",
        "content/integration-callback-bridge.js",
        "content/integration-readiness-client.js",
        "content/canonical-integrations-client.js",
        "content/tool-runtime-client.js",
        "content/mcp-runtime-client.js",
        "content/mcp-marketplace-client.js",
        "content/context-engine-client.js",
        "content/reversible-operations-client.js",
        "content/continuity-runtime-client.js",
        "content/local-agent-orchestrator-client.js",
        "content/agent-runtime-registry-client.js",
        "content/portable-skills-client.js",
        "content/agent-sandbox-client.js",
        "content/native-agent-session-client.js",
        "launcher/canonical-runtime-wiring.js",
        "launcher/canonical-integrations-center.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.6.84 · Integrations Center"
  }
}
